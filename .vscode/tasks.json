{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "make windows",
            "type": "shell",
            "command": "make",
            "args": ["windows"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"],
            "group": { "kind": "build", "isDefault": true },
            "presentation": { "echo": true, "reveal": "always", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": false }
        },
        {
            "label": "make native",
            "type": "shell",
            "command": "make",
            "args": ["native"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"],
            "presentation": { "echo": true, "reveal": "always", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": false }
        },
        {
            "label": "generate dSYM",
            "type": "shell",
            "command": "dsymutil",
            "args": ["build/liboscar.dylib"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "make macos",
            "dependsOrder": "sequence",
            "dependsOn": ["make native", "generate dSYM"],
            "problemMatcher": []
        }
    ]
}
