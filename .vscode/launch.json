{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(lldb) Attach Wine - oscar.dll",
            "type": "cppdbg",
            "request": "attach",
            "program": "${workspaceFolder}/zig-out/bin/oscar.dll",
            "processId": "${command:pickProcess}",
            "MIMode": "lldb",
            "miDebuggerPath": "/usr/bin/lldb-mi",
            "targetArchitecture": "x86",
            "setupCommands": [
                {
                    "description": "Set architecture to i386 for 32-bit Wine process",
                    "text": "settings set target.default-arch i386",
                    "ignoreFailures": true
                },
                {
                    "description": "Enable inline breakpoints",
                    "text": "settings set target.inline-breakpoint-strategy always",
                    "ignoreFailures": true
                },
                {
                    "description": "Search path so LLDB can find oscar.pdb next to oscar.dll",
                    "text": "settings append target.debug-file-search-paths ${workspaceFolder}/zig-out/bin",
                    "ignoreFailures": true
                },
                {
                    "description": "Explicitly load PDB symbols for oscar.dll",
                    "text": "target symbols add ${workspaceFolder}/zig-out/bin/oscar.pdb",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "(lldb) Launch MAC",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/starcraft/BWAPILauncher",
            "preLaunchTask": "zig build macos",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/starcraft",
            "envFile": "${workspaceFolder}/.mac.env",
            "environment": [],
            "externalConsole": false,
            "MIMode": "lldb",
            "targetArchitecture": "arm64",
            "setupCommands": [
                {
                    "description": "Set architecture to arm64",
                    "text": "settings set target.prefer-dynamic-value no-dynamic-values",
                    "ignoreFailures": true
                },
                {
                    "description": "Enable inline breakpoints",
                    "text": "settings set target.inline-breakpoint-strategy always",
                    "ignoreFailures": true
                },
                {
                    "description": "Add debug symbol search path",
                    "text": "settings append target.debug-file-search-paths ${workspaceFolder}/zig-out/lib",
                    "ignoreFailures": true
                },
                {
                    "description": "Set pending breakpoints",
                    "text": "settings set target.load-script-from-symbol-file false",
                    "ignoreFailures": true
                },
                {
                    "description": "Load liboscar dSYM bundle",
                    "text": "target symbols add ${workspaceFolder}/zig-out/lib/liboscar.dylib.dSYM",
                    "ignoreFailures": true
                }
            ],
            "additionalSOLibSearchPath": "${workspaceFolder}/zig-out/lib"
        }
    ]
}